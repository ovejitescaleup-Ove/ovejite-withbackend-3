{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "jsx": "preserve",
  "module": "esnext",
  "moduleResolution": "bundler",
  "lib": [
    "esnext",
    "dom"
  ],
  "target": "esnext",
  "checkJs": false,
  "skipLibCheck": true,
  "allowSyntheticDefaultImports": true,
  "esModuleInterop": true,
  "resolveJsonModule": true
}